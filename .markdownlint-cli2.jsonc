{
  "config": {
    "default": true,

    // Heading style: atx
    "MD003": { "style": "atx" },

    // Unordered list style: dash
    "MD004": { "style": "dash" },

    // Unordered list indent: 2 spaces
    "MD007": { "indent": 2 },

    // Allow hard tabs in code blocks
    "MD010": { "code_blocks": false },

    // Disable line length: prose stays one-paragraph-per-line for clean diffs
    "MD013": false,

    // Allow duplicate headings under different parents
    "MD024": { "siblings_only": true },

    // Heading trailing punctuation: only flag .,;:
    "MD026": { "punctuation": ".,;:" },

    // Ordered list style: incremental (1. 2. 3.)
    "MD029": { "style": "ordered" },

    // Disable no-inline-html
    "MD033": false,

    // Disable bare URL check
    "MD034": false,

    // Disable first-line heading
    "MD041": false,

    // Code block style: fenced
    "MD046": { "style": "fenced" },

    // Code fence style: backtick
    "MD048": { "style": "backtick" },

    // Emphasis style: underscore for italic
    "MD049": { "style": "underscore" },

    // Strong style: asterisk for bold
    "MD050": { "style": "asterisk" }
  },

  "ignores": [
    "node_modules/",
    "result"
  ]
}
