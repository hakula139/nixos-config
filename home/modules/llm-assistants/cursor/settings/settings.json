{
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[less]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "[proto3]": {
    "editor.defaultFormatter": "DrBlury.protobuf-vsc"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "bashIde.shfmt.binaryNextLine": true,
  "bashIde.shfmt.caseIndent": true,
  "C_Cpp.clang_format_fallbackStyle": "Google",
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.default.cppStandard": "c++23",
  "C_Cpp.default.cStandard": "c23",
  "C_Cpp.experimentalFeatures": "enabled",
  "C_Cpp.inlayHints.referenceOperator.enabled": true,
  "catppuccin.accentColor": "teal",
  "catppuccin.boldKeywords": false,
  "catppuccin.bracketMode": "dimmed",
  "catppuccin.colorOverrides": {
    "mocha": {
      "base": "#0F111A",
      "crust": "#090B10",
      "mantle": "#090B10",
      "overlay0": "#3E445D",
      "overlay1": "#464B5D",
      "subtext0": "#80869E",
      "subtext1": "#8F93A2",
      "surface0": "#1A1C25",
      "surface1": "#292D3E",
      "surface2": "#3B3F51",
      "text": "#BABED8"
    }
  },
  "catppuccin.customUIColors": {
    "mocha": {
      "activityBar.foreground": "text",
      "editorCursor.foreground": "#FFCC00",
      "editorLineNumber.activeForeground": "overlay1",
      "list.activeSelectionForeground": "accent",
      "list.inactiveSelectionForeground": "accent",
      "sideBar.foreground": "overlay2",
      "sideBarTitle.foreground": "text",
      "statusBar.foreground": "overlay2",
      "tab.activeForeground": "text",
      "terminalCursor.foreground": "#FFCC00",
      "titleBar.activeForeground": "subtext0"
    }
  },
  "catppuccin.extraBordersEnabled": true,
  "catppuccin.italicComments": true,
  "catppuccin.italicKeywords": true,
  "catppuccin.syncWithIconPack": true,
  "catppuccin.workbenchMode": "default",
  "clangd.checkUpdates": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true,
  "cmake.allowCommentsInPresetsFile": true,
  "cmake.configureOnOpen": false,
  "cmake.ctest.allowParallelJobs": true,
  "cmake.options.statusBarVisibility": "icon",
  "cmake.showConfigureWithDebuggerNotification": false,
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "cSpell.allowCompoundWords": true,
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.diagnosticLevelFlaggedWords": "Information",
  "cSpell.language": "en,en-GB",
  "cSpell.userWords": ["hakula"],
  "css.lint.unknownAtRules": "ignore",
  "cursor.composer.textSizeScale": 1.15,
  "cursor.cpp.disabledLanguages": [],
  "cursor.cpp.enablePartialAccepts": true,
  "cursorpyright.analysis.autoImportCompletions": true,
  "cursorpyright.analysis.inlayHints.callArgumentNames": true,
  "cursorpyright.analysis.inlayHints.callArgumentNamesMatching": true,
  "cursorpyright.analysis.inlayHints.functionReturnTypes": true,
  "cursorpyright.analysis.inlayHints.genericTypes": true,
  "cursorpyright.analysis.inlayHints.variableTypes": true,
  "cursorpyright.analysis.typeCheckingMode": "strict",
  "debug.console.fontSize": 14,
  "debug.javascript.unmapMissingSources": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.fontFamily": "Maple Mono NF CN, Sarasa Mono SC, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.formatOnType": false,
  "editor.inlayHints.fontFamily": "Maple Mono NF CN, Sarasa Mono SC, monospace",
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on"
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.tabSize": 2,
  "editor.wrappingStrategy": "advanced",
  "errorLens.gutterIconsEnabled": true,
  "errorLens.statusBarColorsEnabled": true,
  "evenBetterToml.formatter.allowedBlankLines": 1,
  "evenBetterToml.formatter.arrayAutoExpand": true,
  "evenBetterToml.formatter.arrayTrailingComma": true,
  "evenBetterToml.formatter.columnWidth": 80,
  "evenBetterToml.formatter.trailingNewline": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    ".env*": "properties",
    "*.json": "jsonc",
    "history": "plaintext"
  },
  "files.autoGuessEncoding": true,
  "files.autoSave": "off",
  "files.eol": "\n",
  "files.trimFinalNewlines": true,
  "git.allowForcePush": true,
  "git.allowNoVerifyCommit": true,
  "git.autofetch": true,
  "git.autoStash": true,
  "git.confirmSync": false,
  "git.detectSubmodules": true,
  "git.diagnosticsCommitHook.Enabled": true,
  "git.enableSmartCommit": true,
  "git.ignoreLegacyWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "git.pruneOnFetch": true,
  "git.pullBeforeCheckout": true,
  "git.rebaseWhenSync": true,
  "git.replaceTagsWhenPull": true,
  "git.showCursorWorktrees": true,
  "git.statusLimit": 500,
  "git.supportCancellation": true,
  "git.terminalGitEditor": true,
  "git.useCommitInputAsStashMessage": true,
  "github.gitProtocol": "ssh",
  "gitlab.duoAgentPlatform.enabled": false,
  "gitlab.duoChat.enabled": false,
  "gitlab.duoCodeSuggestions.enabled": false,
  "gitlens.ai.model": "gitkraken",
  "gitlens.gitCommands.skipConfirmations": [
    "fetch:command",
    "stash-push:command",
    "switch:command",
    "push:command"
  ],
  "gitlens.launchpad.indicator.enabled": false,
  "gitlens.views.contributors.files.layout": "tree",
  "go.toolsManagement.autoUpdate": true,
  "harper.dialect": "American",
  "harper.diagnosticSeverity": "hint",
  "harper.linters.CompoundNouns": false,
  "harper.linters.DisjointPrefixes": false,
  "harper.linters.ExpandArgument": false,
  "harper.linters.ExpandStandardInputAndOutput": false,
  "harper.linters.InflectedVerbAfterTo": false,
  "harper.linters.MassNouns": false,
  "harper.linters.MissingDeterminer": false,
  "harper.linters.MissingPreposition": false,
  "harper.linters.MissingTo": false,
  "harper.linters.MoreAdjective": false,
  "harper.linters.OneOfTheSingular": false,
  "harper.linters.OrthographicConsistency": false,
  "harper.linters.OxfordComma": false,
  "harper.linters.PhrasalVerbAsCompoundNoun": false,
  "harper.linters.SentenceCapitalization": false,
  "harper.linters.SpellCheck": false,
  "harper.linters.SplitWords": false,
  "harper.linters.ThereIsAgreement": false,
  "harper.linters.ToDoHyphen": false,
  "harper.linters.UseTitleCase": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "jupyter.askForKernelRestart": false,
  "lldb.suppressUpdateNotifications": true,
  "markdown-preview-enhanced.breakOnSingleNewLine": false,
  "markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
  "markdown-preview-enhanced.enableExtendedTableSyntax": true,
  "markdown-preview-enhanced.enableHTML5Embed": true,
  "markdown-preview-enhanced.enableLinkify": false,
  "markdown-preview-enhanced.imageUploader": "sm.ms",
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "markdown-preview-enhanced.printBackground": true,
  "markdown-preview-enhanced.revealjsTheme": "night.css",
  "markdown.extension.completion.enabled": true,
  "markdown.extension.italic.indicator": "_",
  "markdown.extension.print.absoluteImgPath": false,
  "markdown.extension.toc.levels": "2..6",
  "markdown.marp.html": "all",
  "markdown.preview.fontFamily": "Sarasa Gothic SC, sans-serif",
  "markdownlint.config": {
    "MD010": {
      "code_blocks": false
    },
    "MD041": false
  },
  "nix.enableLanguageServer": true,
  "notebook.output.scrolling": true,
  "redhat.telemetry.enabled": true,
  "remote.autoForwardPortsSource": "hybrid",
  "remote.extensionKind": {
    "WakaTime.vscode-wakatime": ["ui"]
  },
  "remote.SSH.remotePlatform": {
    "CloudCone-US-1": "linux",
    "CloudCone-US-2": "linux",
    "CloudCone-US-3": "linux",
    "DMIT-US-4": "linux",
    "Hakula-MacBook": "macOS",
    "Tencent-SG-1": "linux"
  },
  "ruff.configurationPreference": "filesystemFirst",
  "scm.defaultViewMode": "tree",
  "search.seedWithNearestWord": true,
  "search.showLineNumbers": true,
  "search.smartCase": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  "terminal.external.osxExec": "Warp.app",
  "terminal.integrated.defaultProfile.linux": "tmux",
  "terminal.integrated.defaultProfile.osx": "tmux",
  "terminal.integrated.fontFamily": "Maple Mono NF CN, JetBrainsMono Nerd Font, Sarasa Term SC, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.minimumContrastRatio": 1,
  "update.showReleaseNotes": false,
  "window.commandCenter": true,
  "window.newWindowProfile": "Default",
  "window.restoreFullscreen": true,
  "window.titleBarStyle": "custom",
  "workbench.activityBar.orientation": "vertical",
  "workbench.colorCustomizations": {
    "terminal.findMatchBackground": "#ffee006e"
  },
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.editorLargeFileConfirmation": 100,
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.preferredDarkColorTheme": "Catppuccin Mocha",
  "yaml.customTags": ["!reference sequence"],
  "yaml.disableSchemaDetection": [
    "**/docker-compose.yml",
    "**/docker-compose.yaml",
    "**/docker-compose.*.yml",
    "**/docker-compose.*.yaml",
    "**/compose.yml",
    "**/compose.yaml",
    "**/compose.*.yml",
    "**/compose.*.yaml",
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml"
  ]
}
