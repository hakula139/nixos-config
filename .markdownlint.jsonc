{
  // MD004, MD048, MD049 and MD050 must agree with the dprint markdown plugin's
  // settings in home/modules/llm-assistants/shared/hooks/default.nix, or the
  // formatter and the linter rewrite each other's output on every save.
  "default": true,
  "MD003": { "style": "atx" },
  "MD004": { "style": "dash" },
  "MD007": { "indent": 2 },
  // A tab inside a fence is content, not indentation: Go and Makefile samples
  // need it, and --fix expands it away wherever this rule is not set.
  "MD010": { "code_blocks": false },
  // Prose is soft-wrapped one sentence per line, so a column limit means nothing.
  "MD013": false,
  "MD024": { "siblings_only": true },
  // Left off ? and ! so a heading can still ask something.
  "MD026": { "punctuation": ".,;:" },
  "MD029": { "style": "ordered" },
  "MD033": false,
  "MD034": false,
  "MD041": false,
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },
  "MD049": { "style": "underscore" },
  "MD050": { "style": "asterisk" }
}
