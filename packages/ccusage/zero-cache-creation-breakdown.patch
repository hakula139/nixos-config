+
+    /// Returns cache writes as `(5m, 1h)` TTL buckets.
+    ///
+    /// An all-zero breakdown next to a nonzero `cache_creation_input_tokens`
+    /// carries no TTL information, as some gateways report it, so the flat
+    /// total is billed at the 5m rate like a missing breakdown.
+    pub fn cache_creation_split(&self) -> (u64, u64) {
+        match self.cache_creation {
+            Some(b) if b.ephemeral_5m_input_tokens != 0 || b.ephemeral_1h_input_tokens != 0 => {
+                (b.ephemeral_5m_input_tokens, b.ephemeral_1h_input_tokens)
+            }
+            _ => (self.cache_creation_input_tokens, 0),
         }
     }
