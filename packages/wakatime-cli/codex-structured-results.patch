From db793408b0555aa3e701ec8b83a284cab1c4ad1c Mon Sep 17 00:00:00 2001
From: Hakula Chen <i@hakula.xyz>
Date: Sat, 3 Oct 2026 17:26:19 +0800
Subject: [PATCH] fix(codex): respect structured tool result status

Read the explicit isError boolean before checking tool output text, so successful structured results produce write heartbeats.

Upstream: https://github.com/wakatime/wakatime-cli/issues/1606

Remove this patch when the pinned upstream release includes the fix.
---
 pkg/ai/codex.go | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/pkg/ai/codex.go b/pkg/ai/codex.go
index 791f1ca..e860f58 100644
--- a/pkg/ai/codex.go
+++ b/pkg/ai/codex.go
@@ -846,6 +846,17 @@ func codexToolCallSucceeded(output json.RawMessage) bool {
 	}
 
 	for _, item := range items {
+		var result struct {
+			IsError *bool `json:"isError"`
+		}
+		if err := json.Unmarshal([]byte(item.Text), &result); err == nil && result.IsError != nil {
+			if *result.IsError {
+				return false
+			}
+
+			continue
+		}
+
 		text := strings.ToLower(item.Text)
 		if strings.Contains(text, "failed") ||
 			strings.Contains(text, "error") ||
-- 
