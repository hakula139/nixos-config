+function canRedirectRunnerToCdn (options: {
+  video: MVideoFullLight
+  file: MVideoFileVideo | MVideoFileStreamingPlaylistVideo
+}) {
+  const { video, file } = options
+
+  if (video.hasPrivateStaticPath()) return false
+
+  const bucket = file.isHLS()
+    ? CONFIG.OBJECT_STORAGE.STREAMING_PLAYLISTS
+    : CONFIG.OBJECT_STORAGE.WEB_VIDEOS
+
+  return !!bucket.BASE_URL
+}
+
+function redirectRunnerToCdn (options: {
+  res: express.Response
+  video: MVideoFullLight
+  file: MVideoFileVideo | MVideoFileStreamingPlaylistVideo
+}) {
+  const { res, video, file } = options
+
+  const url = file.getObjectStorageUrl(video)
+
+  logger.debug('Redirecting runner to CDN URL %s for file %s.', url, file.filename, lTags())
+
+  return res.redirect(303, url)
+}
