+function tryRedirectToCdn (
+  res: express.Response,
+  config: BucketInfo & { BASE_URL: string },
+  key: string,
+  filename: string
+) {
+  if (!config.BASE_URL) {
+    return false
+  }
+
+  const internalUrl = getInternalUrl(config, key)
+  const cdnUrl = getObjectStoragePublicFileUrl(internalUrl, config)
+
+  logger.debug('Redirecting runner to CDN URL for file %s.', filename, lTags())
+  res.redirect(303, cdnUrl)
+  return true
+}
