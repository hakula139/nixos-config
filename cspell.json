{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "gitignoreRoot": ".",
  "allowCompoundWords": true,
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "ignorePaths": [
    "**/*.patch",
    "**/fixtures/**",
    "data/corp-domain.nix",
    "flake.lock",
    "secrets/**/*.age"
  ]
}
